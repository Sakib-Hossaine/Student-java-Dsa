#include <iostream>
#include <vector>
using namespace std;

class MinHeap {
private:
    vector<int> heap;

    // Get parent, left child, right child indices
    int parent(int i) { return (i - 1) / 2; }
    int leftChild(int i) { return 2 * i + 1; }
    int rightChild(int i) { return 2 * i + 2; }

    // Bubble up to maintain heap property after insert
    void heapifyUp(int i) {
        while (i > 0 && heap[parent(i)] > heap[i]) {
            swap(heap[i], heap[parent(i)]);
            i = parent(i);
        }
    }

    // Bubble down to maintain heap property after removal
    void heapifyDown(int i) {
        int smallest = i;
        int left = leftChild(i);
        int right = rightChild(i);

        if (left < heap.size() && heap[left] < heap[smallest])
            smallest = left;
        if (right < heap.size() && heap[right] < heap[smallest])
            smallest = right;

        if (smallest != i) {
            swap(heap[i], heap[smallest]);
            heapifyDown(smallest);
        }
    }

public:
    // Insert a new value
    void insert(int value) {
        heap.push_back(value);
        heapifyUp(heap.size() - 1);
    }

    // Get minimum element (for max heap, this would be maximum)
    int peek() {
        if (heap.empty()) {
            throw runtime_error("Heap is empty");
        }
        return heap[0];
    }

    // Remove and return the min element
    int extractMin() {
        if (heap.empty()) {
            throw runtime_error("Heap is empty");
        }

        int minVal = heap[0];
        heap[0] = heap.back();
        heap.pop_back();

        if (!heap.empty()) {
            heapifyDown(0);
        }

        return minVal;
    }

    // Delete element at index i
    void deleteAt(int i) {
        if (i >= heap.size()) return;

        heap[i] = heap.back();
        heap.pop_back();

        if (i < heap.size()) {
            heapifyUp(i);
            heapifyDown(i);
        }
    }

    int size() { return heap.size(); }
    bool isEmpty() { return heap.empty(); }

    // Build heap from an array
    void buildHeap(vector<int>& arr) {
        heap = arr;
        for (int i = heap.size() / 2 - 1; i >= 0; i--) {
            heapifyDown(i);
        }
    }

    void print() {
        for (int val : heap) cout << val << " ";
        cout << endl;
    }
};

// Example usage
int main() {
    MinHeap h;

    h.insert(10);
    h.insert(20);
    h.insert(5);
    h.insert(30);
    h.insert(15);

    cout << "Heap: ";
    h.print();

    cout << "Min: " << h.peek() << endl;

    cout << "Extracted: " << h.extractMin() << endl;
    cout << "Heap after extraction: ";
    h.print();

    // Build from array
    MinHeap h2;
    vector<int> arr = {9, 4, 7, 1, 3, 8, 2};
    h2.buildHeap(arr);
    cout << "Built heap: ";
    h2.print();

    return 0;
}
